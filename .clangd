# Editor/clangd configuration for Injector-Kernel (MSBuild+WDK project).
# The authoritative build is `Build\Executors\Create.bat` / MSBuild with WDK.
# This file reduces false diagnostics in editors; it does not replace the build.

If:
  PathMatch: Driver/.*
CompileFlags:
  Add:
    - -xc
    - -std=c17
    - -fms-extensions
    - -fms-compatibility
    - -fdeclspec
    - -Wno-unknown-argument
    - -D_WIN64
    - -D_AMD64_
    - -DAMD64
    - -D_KERNEL_MODE=1
    - -DNTDDI_VERSION=0x0A000012
    - -D_WIN32_WINNT=0x0A00
    - -DUNICODE
    - -D_UNICODE
    - -DINJECTOR_CHANNEL_MAGIC=0xA7E3C1D9F042B685ULL
    - -DINJECTOR_POOL_TAG='sfTN'
    - '-DINJECTOR_CLIENT_IMAGE_NAME="Client.exe"'
    - -DINJECTOR_PDATA_RVA=0x0
    - -DINJECTOR_PDATA_SIZE=0x0
    - -I.
    - -IDriver
    - "-IC:/Program Files (x86)/Windows Kits/10/Include/10.0.28000.0/km"
    - "-IC:/Program Files (x86)/Windows Kits/10/Include/10.0.28000.0/km/crt"
    - "-IC:/Program Files (x86)/Windows Kits/10/Include/10.0.28000.0/shared"
    - "-IC:/Program Files (x86)/Windows Kits/10/Include/10.0.28000.0/ucrt"
  Remove:
    - -target
    - --target*
Diagnostics:
  Suppress:
    - unknown-argument
    - drv_unknown_argument
    - pp_file_not_found
    - unknown_typename
    - unknown_typename_suggest
  ClangTidy:
    Remove: [misc-include-cleaner]

---

If:
  PathMatch: Client/.*
CompileFlags:
  Add:
    - -fms-extensions
    - -fms-compatibility
    - -D_WIN64
    - -D_AMD64_
    - -DUNICODE
    - -D_UNICODE
    - -DWIN32_LEAN_AND_MEAN
    - -DINJECTOR_CHANNEL_MAGIC=0xA7E3C1D9F042B685ULL
    - -DINJECTOR_CHANNEL_USER_VA=0x00007FF000000000ULL
    - -I.
    - "-IC:/Program Files (x86)/Windows Kits/10/Include/10.0.28000.0/um"
    - "-IC:/Program Files (x86)/Windows Kits/10/Include/10.0.28000.0/shared"
    - "-IC:/Program Files (x86)/Windows Kits/10/Include/10.0.28000.0/ucrt"
  Remove:
    - -target
    - --target*
Diagnostics:
  Suppress:
    - unknown-argument
    - drv_unknown_argument
  ClangTidy:
    Remove: [misc-include-cleaner]

---

CompileFlags:
  Add:
    - -fms-extensions
    - -fms-compatibility
  Remove:
    - -target
    - --target*
Diagnostics:
  Suppress:
    - unknown-argument
    - drv_unknown_argument
  ClangTidy:
    Remove: [misc-include-cleaner]
